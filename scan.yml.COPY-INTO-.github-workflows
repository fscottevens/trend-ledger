name: Scheduled scan

on:
  # ---------------------------------------------------------------------
  # Hourly during US market hours, weekdays.
  #
  # WHY MINUTE :17 AND NOT :00 --- deliberate. GitHub's documentation says:
  # "The schedule event can be delayed during periods of high loads of
  # GitHub Actions workflow runs. High load times include the start of
  # every hour. If the load is sufficiently high enough, some queued jobs
  # may be dropped. To decrease the chance of delay, schedule your workflow
  # to run at a different time of the hour."
  #
  # :00, :15, :30 and :45 are the crowded slots where public-repo jobs get
  # deprioritised or dropped. :17 gives the same hourly cadence with a much
  # better chance of firing on time.
  #
  # 13:00-21:00 UTC is roughly 9am-5pm ET. UTC does not shift for daylight
  # saving, so this window drifts an hour between EDT and EST.
  # ---------------------------------------------------------------------
  schedule:
    - cron: "17 13-21 * * 1-5"
  workflow_dispatch: {}

permissions:
  contents: write

# Prevents two runs committing at the same time. A queued run waits rather
# than racing the one in progress.
concurrency:
  group: scheduled-scan
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-python@v6
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run scan
        run: python sepa_scanner.py --json-out docs/data/latest.json
        # No continue-on-error on purpose. An earlier version suppressed
        # failures to avoid email noise, which meant a scan failing every
        # time still reported success and the site went stale silently.

      - name: Commit updated data
        run: |
          set -e
          git config user.name "trend-ledger-bot"
          git config user.email "actions@users.noreply.github.com"

          if git diff --quiet -- docs/data/latest.json; then
            echo "No data change this run; nothing to commit."
            exit 0
          fi

          # Keep our freshly generated scan output aside. If anything else
          # was pushed while this scan was running, we rebuild on top of it
          # rather than trying to merge two versions of a generated file.
          cp docs/data/latest.json /tmp/latest.json

          # Retry loop: a push can be rejected if another commit lands in the
          # seconds between our fetch and our push. Rather than failing the
          # whole run (which is what kept happening), re-sync and try again.
          for attempt in 1 2 3 4 5; do
            echo "--- push attempt $attempt ---"

            git fetch origin main
            git reset --hard origin/main

            # Our scan output always wins for this file: it is regenerated
            # data, not hand-edited content, so there is nothing to preserve
            # from the remote copy.
            mkdir -p docs/data
            cp /tmp/latest.json docs/data/latest.json

            if git diff --quiet -- docs/data/latest.json; then
              echo "Remote already matches this scan; nothing to push."
              exit 0
            fi

            git add docs/data/latest.json
            git commit -m "Scheduled scan update $(date -u +'%Y-%m-%d %H:%M UTC')"

            if git push origin HEAD:main; then
              echo "Pushed successfully on attempt $attempt."
              exit 0
            fi

            echo "Push rejected (something else landed first). Re-syncing and retrying..."
            sleep $(( attempt * 5 ))
          done

          echo "::error::Could not push scan data after 5 attempts."
          exit 1
